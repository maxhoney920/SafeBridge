{
  "manifest_version": 3,
  "name": "VlessBridge",
  "description": "VPN для браузера по VLESS: серверы из ссылки-подписки, выбор сервера и проксирование только нужных сайтов.",
  "version": "0.5.10",
  "minimum_chrome_version": "110",
  "key": "",
  "permissions": ["proxy", "storage", "alarms", "nativeMessaging", "privacy", "activeTab", "scripting"],
  "host_permissions": ["https://tapp.internet-safe.online/*"],
  "content_scripts": [{ "matches": ["https://tapp.internet-safe.online/ext/done*"], "js": ["src/account-done.js"], "run_at": "document_idle" }],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VlessBridge",
    "default_icon": { "16": "icons/off-16.png", "32": "icons/off-32.png" }
  },
  "options_page": "options.html",
  "icons": { "16": "icons/on-16.png", "32": "icons/on-32.png", "48": "icons/app-48.png", "128": "icons/app-128.png" }
}
