{
  "manifest_version": 2,
  "name": "VlessBridge",
  "description": "VPN для браузера по VLESS: серверы из ссылки-подписки, выбор сервера и проксирование только нужных сайтов.",
  "version": "0.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "vlessbridge@safebridge",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["proxy", "storage", "alarms", "nativeMessaging", "privacy", "tabs", "<all_urls>"],
  "background": { "page": "background.html" },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "VlessBridge",
    "default_icon": { "16": "icons/off-16.png", "32": "icons/off-32.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "16": "icons/on-16.png", "32": "icons/on-32.png", "48": "icons/app-48.png", "128": "icons/app-128.png" }
}
